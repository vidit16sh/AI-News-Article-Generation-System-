// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

model Category {
  id    Int           @id @default(autoincrement())
  name  String        // Display Name (e.g. "Bitcoin")
  slug  String        @unique 
  news  CleanedNews[]
}

model RawNews {
  id        String   @id @default(uuid())
  sourceUrl String   @unique
  title     String
  rawBody   String? 
  publishedAt DateTime @default(now())
  fetchedAt DateTime @default(now())
  processed Boolean  @default(false)

  @@index([processed, publishedAt])
  @@index([publishedAt])
  @@index([fetchedAt])
}

model CleanedNews {
  id           String   @id @default(uuid())
  title        String
  summary      String
  content      String
  sourceUrl    String   @unique
  publishedAt  DateTime
  categoryId   Int
  category     Category @relation(fields: [categoryId], references: [id])
  createdAt    DateTime @default(now()) 
  
  generatedArticle GeneratedArticle?

  @@index([createdAt])
  @@index([publishedAt])
}

model ProcessingLog {
  id        Int      @id @default(autoincrement())
  newsId    String?
  status    String   
  message   String
  timestamp DateTime @default(now())
} 

model Author {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique // e.g., "james-carter"
  role        String   // e.g., "Senior Crypto Analyst"
  bio         String   @db.Text 
  expertise   String[]
  imageUrl    String   // Path to image, e.g., "/authors/james.jpg"
  email       String?
  twitter     String?
  linkedin    String?
  
  // Relation back to articles
  articles    GeneratedArticle[]
  
  createdAt   DateTime @default(now())
}

model GeneratedArticle {
  id              String   @id @default(uuid())
  originalNewsId  String   @unique
  originalNews    CleanedNews @relation(fields: [originalNewsId], references: [id])

  // Core Content
  headline        String
  slug            String   @unique
  metaDescription String
  articleHtml     String   // The full HTML body
  // Metadata & SEO
  tags            String[] // Stores tags as a list
  keywords        String[] // Main keywords
  
  imageUrl        String? 
  
  // Advanced Fields (Requested in your prompt)
  newsJsonLd      Json?    // Stores the Schema.org JSON-LD object
  originalityScore Float   @default(0.0)
  confidenceScore  Float   @default(0.0)
  priorityScore   Int      @default(0)  // 0 to 100
  publishAt       DateTime @default(now()) // When it should go live
  
  authorId        String?
  author          Author?  @relation(fields: [authorId], references: [id])
  
  // Publishing Status
  status          String   @default("DRAFT") // DRAFT, QUEUED, PUBLISHED
   
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt 
  @@index([status, publishAt]) // Fast lookups for "Recent Published Articles"
  @@index([status, createdAt])
  @@index([slug])
}

model SourceReliability {
  id                Int      @id @default(autoincrement())
  sourceKey         String   @unique
  fetchRuns         Int      @default(0)
  fetchSuccessRuns  Int      @default(0)
  scrapeAttempts    Int      @default(0)
  scrapeSuccesses   Int      @default(0)
  savedItems        Int      @default(0)
  blockedItems      Int      @default(0)
  avgContentLength  Float    @default(0.0)
  publishConversion Float    @default(0.0)
  reliabilityScore  Float    @default(50.0)
  lastRunAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model IngestDiagnostic {
  id          Int      @id @default(autoincrement())
  service     String
  reasonCode  String
  sourceKey   String?
  sourceUrl   String?
  rawNewsId   String?
  cleanedNewsId String?
  details     Json?
  createdAt   DateTime @default(now())

  @@index([reasonCode, createdAt])
  @@index([sourceKey, createdAt])
}
