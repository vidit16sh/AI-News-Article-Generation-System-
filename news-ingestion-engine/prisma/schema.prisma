// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id    Int    @id @default(autoincrement())
  name  String @unique
  news  CleanedNews[]
}

model RawNews {
  id        String   @id @default(uuid())
  sourceUrl String   @unique
  title     String
  rawBody   String? 
  publishedAt DateTime @default(now())
  fetchedAt DateTime @default(now())
  processed Boolean  @default(false)
}

model CleanedNews {
  id           String   @id @default(uuid())
  title        String
  summary      String
  content      String
  sourceUrl    String
  publishedAt  DateTime
  categoryId   Int
  category     Category @relation(fields: [categoryId], references: [id])
  createdAt    DateTime @default(now()) 
  
  generatedArticle GeneratedArticle?
}

model ProcessingLog {
  id        Int      @id @default(autoincrement())
  newsId    String?
  status    String   
  message   String
  timestamp DateTime @default(now())
} 

model GeneratedArticle {
  id              String   @id @default(uuid())
  headline        String
  slug            String   @unique
  metaDescription String
  tags            String[] // Stores tags as a list
  content         String   // The HTML body
  createdAt       DateTime @default(now())
  
  // Link back to the source signal
  originalNewsId  String   @unique
  originalNews    CleanedNews @relation(fields: [originalNewsId], references: [id])
}